<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <OutputType Condition="'$(Configuration)' == 'ReleaseTronCli'">Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MainPatchedImproved</RootNamespace>
    <AssemblyName>MainPatchedImproved</AssemblyName>
    <DefineConstants Condition="'$(Configuration)' == 'ReleaseTrustWallet'">$(DefineConstants);TRUSTWALLET</DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'ReleaseTronCli'">$(DefineConstants);TRONCLI</DefineConstants>
    <!-- exe 아이콘: 이 폴더에 logo.ico 넣고 빌드하면 적용됨 -->
    <ApplicationIcon Condition="Exists('$(MSBuildProjectDirectory)\logo.ico')">logo.ico</ApplicationIcon>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugType Condition="'$(Configuration)' == 'ReleaseTrustWallet'">none</DebugType>
    <DebugType Condition="'$(Configuration)' == 'ReleaseTronCli'">none</DebugType>
    <Optimize Condition="'$(Configuration)' == 'ReleaseTrustWallet'">true</Optimize>
    <Optimize Condition="'$(Configuration)' == 'ReleaseTronCli'">true</Optimize>
    <!-- RID 지정 시(발행 시): .NET 설치 없이 실행되는 single-file -->
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(RuntimeIdentifier)' != ''">true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="logo.ico" Condition="Exists('$(MSBuildProjectDirectory)\logo.ico')" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NBitcoin" Version="7.0.30" />
    <PackageReference Include="Nethereum.Util" Version="4.28.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20240615" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.10.0.20240615" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240615" />
  </ItemGroup>

  <!-- 리소스를 output/data 폴더로 복사 (실행 폴더 맨 위에는 exe만 두기 위함) -->
  <Target Name="CopyDataToOutput" AfterTargets="Build">
    <PropertyGroup>
      <_DataDir>$(OutputPath)data\</_DataDir>
      <_DataDirPicsKr>$(_DataDir)pic\kr\</_DataDirPicsKr>
      <_DataDirPicsTw>$(_DataDir)pic\trustwallet\</_DataDirPicsTw>
    </PropertyGroup>
    <MakeDir Directories="$(_DataDirPicsKr)" />
    <MakeDir Directories="$(_DataDirPicsTw)" />
    <Copy SourceFiles="$(ProjectDir)..\wordlist.txt" DestinationFolder="$(_DataDir)" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)..\wordlist.txt')" />
    <Copy SourceFiles="$(ProjectDir)logo.png" DestinationFolder="$(_DataDir)" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)logo.png')" />
    <Copy SourceFiles="$(ProjectDir)logo.ico" DestinationFolder="$(_DataDir)" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)logo.ico')" />
    <Copy SourceFiles="$(ProjectDir)server_url.sample.txt" DestinationFolder="$(_DataDir)" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)server_url.sample.txt')" />
    <ItemGroup>
      <_PicFilesKr Include="$(ProjectDir)..\pic\kr\**\*" />
      <_PicFilesTw Include="$(ProjectDir)..\pic\trustwallet\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PicFilesKr)" DestinationFolder="$(_DataDirPicsKr)%(RecursiveDir)" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)..\pic\kr')" />
    <Copy SourceFiles="@(_PicFilesTw)" DestinationFolder="$(_DataDirPicsTw)%(RecursiveDir)" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)..\pic\trustwallet')" />
  </Target>
  <Target Name="CopyDataToPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_PublishDataDir>$(PublishDir)data\</_PublishDataDir>
      <_PublishDataPicsKr>$(_PublishDataDir)pic\kr\</_PublishDataPicsKr>
      <_PublishDataPicsTw>$(_PublishDataDir)pic\trustwallet\</_PublishDataPicsTw>
    </PropertyGroup>
    <MakeDir Directories="$(_PublishDataPicsKr)" />
    <MakeDir Directories="$(_PublishDataPicsTw)" />
    <Copy SourceFiles="$(ProjectDir)..\wordlist.txt" DestinationFolder="$(_PublishDataDir)" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)..\wordlist.txt')" />
    <Copy SourceFiles="$(ProjectDir)logo.png" DestinationFolder="$(_PublishDataDir)" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)logo.png')" />
    <Copy SourceFiles="$(ProjectDir)logo.ico" DestinationFolder="$(_PublishDataDir)" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)logo.ico')" />
    <Copy SourceFiles="$(ProjectDir)server_url.sample.txt" DestinationFolder="$(_PublishDataDir)" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)server_url.sample.txt')" />
    <ItemGroup>
      <_PicFilesPublishKr Include="$(ProjectDir)..\pic\kr\**\*" />
      <_PicFilesPublishTw Include="$(ProjectDir)..\pic\trustwallet\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PicFilesPublishKr)" DestinationFolder="$(_PublishDataPicsKr)%(RecursiveDir)" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)..\pic\kr')" />
    <Copy SourceFiles="@(_PicFilesPublishTw)" DestinationFolder="$(_PublishDataPicsTw)%(RecursiveDir)" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)..\pic\trustwallet')" />
  </Target>

</Project>
